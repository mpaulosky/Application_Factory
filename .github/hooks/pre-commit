#!/usr/bin/env bash
# Pre-commit gate. First it refuses a commit made in the primary checkout:
# every change is made in a linked worktree under ../<Repo>-worktrees/.
# Then it runs markdownlint-cli2 on staged .md files, with the same
# .markdownlint-cli2.jsonc config as CI. It lints the staged content, not the
# working copy, so a partly staged file is checked as it will be committed.
# Blocks the commit if any markdownlint violations are found. It fails closed:
# a git command, the temporary folder or the snapshot of the staged files that
# fails, or a markdownlint-cli2 too old to take a literal path, refuses the
# commit rather than letting it through unlinted. Only a missing
# markdownlint-cli2 is skipped, with a warning.
set -uo pipefail

# Pathspecs below mean what they say, whatever the caller's environment asks.
unset GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

# ── Commit only in a linked worktree ───────────────────────────────────────
# In the primary checkout the git dir is the common one. A repo with no
# commits on any ref is exempt, so a new repo's first commit (the Apply) goes
# on main; an orphan branch in a repo with history is not. A clone that can't
# use worktrees opts out with baseline.allowPrimaryCommits.
GIT_DIR_ABS="$(git rev-parse --absolute-git-dir)"
COMMON_DIR_ABS="$(git rev-parse --path-format=absolute --git-common-dir)"
if [[ "$GIT_DIR_ABS" == "$COMMON_DIR_ABS" ]] \
  && [[ -n "$(git rev-list -n 1 --all)" ]] \
  && [[ "$(git config --bool baseline.allowPrimaryCommits)" != true ]]; then
  # Absolute paths: the hook's cd doesn't move the shell that ran git commit.
  WORKTREES="$(dirname "$ROOT")/$(basename "$ROOT")-worktrees"
  BRANCH="$(git symbolic-ref -q --short HEAD || true)"
  echo -e "${RED}❌  Commit in a worktree, not in the primary checkout ($ROOT).${RESET}"
  if [[ -n "$BRANCH" && "$BRANCH" != main ]] && git rev-parse -q --verify "refs/heads/$BRANCH" > /dev/null; then
    # The branch already exists and is checked out here, so it can't also be
    # checked out in a worktree until the primary checkout is back on main.
    FOLDER="${BRANCH//\//-}"
    echo -e "    Move $BRANCH into its own worktree, and carry your changes over with a stash:"
    echo -e "      ${CYAN}git stash push --include-untracked${RESET}"
    echo -e "      ${CYAN}git switch main${RESET}"
    echo -e "      ${CYAN}git worktree add \"$WORKTREES/$FOLDER\" $BRANCH${RESET}"
    echo -e "      ${CYAN}cd \"$WORKTREES/$FOLDER\" && git stash pop --index${RESET}"
  else
    echo -e "    Start the branch in its own worktree, and carry your changes over with a stash."
    echo -e "    <branch> is feature|fix|hotfix/<issue>-<slug> or chore/<slug>; <folder> is <branch> with / as -."
    echo -e "      ${CYAN}git stash push --include-untracked${RESET}"
    echo -e "      ${CYAN}git fetch origin${RESET}"
    echo -e "      ${CYAN}git worktree add --no-track -b <branch> \"$WORKTREES/<folder>\" origin/main${RESET}"
    echo -e "      ${CYAN}cd \"$WORKTREES/<folder>\" && git stash pop --index${RESET}"
  fi
  echo -e "    For a clone that can't use worktrees: ${YELLOW}git config baseline.allowPrimaryCommits true${RESET}"
  exit 1
fi

# refuse <what failed>: say the commit is refused, and what to do about it.
refuse() {
  echo -e "${RED}❌  $1: the commit is refused.${RESET}"
  echo -e "    See git's message above (or check TMPDIR and free disk space), fix it, then commit again."
  echo -e "    To skip in an emergency: ${YELLOW}git commit --no-verify${RESET}"
  exit 1
}

# ── Collect staged .md files ───────────────────────────────────────────────
# First whether any staged .md file is added, changed or renamed (exit 1), none
# is (0), or git failed (anything else), so a commit with no Markdown needs no
# temporary folder, and a git that fails refuses the commit instead of letting
# it through unlinted. ('*.md' matches at any depth: a pathspec's * matches /.)
git diff --cached --quiet --diff-filter=ACMR -- '*.md'
case $? in
  0) exit 0 ;;
  1) ;;
  *) refuse "git diff --cached failed, so the staged Markdown can't be listed" ;;
esac

# NUL-separated, so paths with spaces or other odd characters survive.
# R counts too: a renamed file is listed under its new name. Written to a file
# first, so a git that fails refuses the commit instead of leaving the list
# empty.
WORK_DIR="$(mktemp -d 2> /dev/null)" || refuse "Couldn't make a temporary folder to lint the staged Markdown in"
trap 'rm -rf "$WORK_DIR"' EXIT
if ! git diff --cached --name-only -z --diff-filter=ACMR > "$WORK_DIR/staged"; then
  refuse "git diff --cached failed, so the staged Markdown can't be listed"
fi
MD_FILES=()
while IFS= read -r -d '' file; do
  [[ "$file" == *.md ]] && MD_FILES+=("$file")
done < "$WORK_DIR/staged"

if [[ ${#MD_FILES[@]} -eq 0 ]]; then
  exit 0
fi

echo -e "${CYAN}━━━ Pre-Commit Markdownlint Gate ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"

# ── Probe for markdownlint binary ──────────────────────────────────────────
MARKDOWNLINT_BIN=""

# Only markdownlint-cli2 reads .markdownlint-cli2.jsonc, the config CI uses.
if [[ -x "$ROOT/node_modules/.bin/markdownlint-cli2" ]]; then
  MARKDOWNLINT_BIN="$ROOT/node_modules/.bin/markdownlint-cli2"
elif command -v markdownlint-cli2 &> /dev/null; then
  MARKDOWNLINT_BIN="markdownlint-cli2"
fi

if [[ -z "$MARKDOWNLINT_BIN" ]]; then
  echo -e "${YELLOW}⚠️   markdownlint-cli2 not found — skipping markdown lint check.${RESET}"
  echo -e "    To enable: ${CYAN}pnpm add -g markdownlint-cli2${RESET}"
  exit 0
fi

# The ':' literal-path prefix used below came in markdownlint-cli2 0.4.0: an
# older one reads ':a.md' as a glob that matches nothing, and passes. Run with
# no arguments, it prints its banner ("markdownlint-cli2 vX.Y.Z ...") on
# stdout. It runs in an empty folder of its own: in the working copy it would
# read (or run) a config there that isn't staged. Only the banner line counts,
# so a warning Node prints first doesn't hide it; what it prints on stderr is
# kept, and shown when no version can be read (a broken node, say).
PROBE="$WORK_DIR/probe"
mkdir "$PROBE" 2> /dev/null || refuse "Couldn't make a temporary folder to read markdownlint-cli2's version in"
LINT_BANNER="$( (cd "$PROBE" && "$MARKDOWNLINT_BIN" < /dev/null) 2> "$WORK_DIR/probe.err" | sed -n '/^markdownlint-cli2 v/{p;q;}')"
LINT_VERSION="$(sed -n 's/^markdownlint-cli2 v\([0-9][0-9]*\)\.\([0-9][0-9]*\)\.[0-9].*/\1 \2/p' <<< "$LINT_BANNER")"
read -r LINT_MAJOR LINT_MINOR <<< "$LINT_VERSION"
if [[ -z "$LINT_VERSION" ]] || ((10#$LINT_MAJOR == 0 && 10#$LINT_MINOR < 4)); then
  echo -e "${RED}❌  $MARKDOWNLINT_BIN is ${LINT_BANNER:-silent}, not markdownlint-cli2 0.4.0 or later, which lints a path as it is named: the commit is refused.${RESET}"
  if [[ -z "$LINT_VERSION" && -s "$WORK_DIR/probe.err" ]]; then
    echo "    It said:"
    head -n 5 "$WORK_DIR/probe.err" | sed 's/^/      /'
  fi
  echo -e "    Update it: ${CYAN}pnpm add -g markdownlint-cli2${RESET}"
  echo -e "    To skip in an emergency: ${YELLOW}git commit --no-verify${RESET}"
  exit 1
fi

# ── Snapshot the staged content ───────────────────────────────────────────
# Write each staged file, and the configs as they will be committed, into a
# temporary tree with the same layout, then lint that tree. The working copy
# can differ from what's staged, and only the staged version gets committed.
SNAPSHOT="$WORK_DIR/snapshot"
mkdir "$SNAPSHOT" 2> /dev/null || refuse "Couldn't make a temporary folder to lint the staged Markdown in"

# Only staged configs are used; one that exists only in the working copy won't
# be in the commit. Nested ones count too: markdownlint-cli2 applies a
# directory's .markdownlint-cli2.jsonc to the files under it, as CI does.
# A failed write (git, a full disk) would lint a tree missing a staged file
# or its config, so it refuses the commit (pipefail: either side failing).
if ! git ls-files -z --cached -- ':(glob)**/.markdownlint-cli2.jsonc' \
  | git checkout-index --prefix="$SNAPSHOT/" -z --stdin; then
  refuse "Couldn't write the staged markdownlint configs to a temporary tree to lint with"
fi
if ! printf '%s\0' "${MD_FILES[@]}" | git checkout-index --prefix="$SNAPSHOT/" -z --stdin; then
  refuse "Couldn't write the staged Markdown files to a temporary tree to lint"
fi

# ── Run markdownlint on staged files ──────────────────────────────────────
echo -e "  Linting staged .md files with: ${CYAN}$(basename "$MARKDOWNLINT_BIN")${RESET}"

# markdownlint-cli2 reads each argument as a glob, so a[1].md would match a1.md: a
# leading ':' makes it a literal path, and keeps a name that starts with '-' or
# '!' from being read as an option or a negation, as scripts/gate.sh does.
if (cd "$SNAPSHOT" && "$MARKDOWNLINT_BIN" "${MD_FILES[@]/#/:}") 2>&1; then
  echo -e "${GREEN}✅  All staged .md files passed markdownlint.${RESET}"
  exit 0
else
  echo -e ""
  echo -e "${RED}❌  Markdownlint violations found in staged files above.${RESET}"
  echo -e "    Fix the violations and re-stage the files before committing."
  echo -e "    To skip in an emergency: ${YELLOW}git commit --no-verify${RESET}"
  exit 1
fi
