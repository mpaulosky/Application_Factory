<?xml version="1.0" encoding="utf-8"?>
<!-- The test project restores from nuget.org alone (ADR 0017, Update for mpaulosky/Application_Factory#145). <clear /> drops every source and mapping a
     NuGet.config above this folder or the user's own adds, so no other feed can serve a package of the same name; packages.lock.json pins each one's hash,
     and test.sh restores in locked mode. The audit sources are cleared the same way, so the vulnerability audit reads nuget.org's advisories alone. -->
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
	</packageSources>
	<packageSourceMapping>
		<clear />
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
	<auditSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	</auditSources>
</configuration>
