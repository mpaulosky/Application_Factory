<Project Sdk="Microsoft.NET.Sdk">
  <!-- The xUnit v3 tests of the Factory's C# scripts (ADR 0017), run by test.sh in its scripts shard. Shielded: the three empty
       Directory.* files beside it stop any of the repo's own from reaching it, so its versions are written here. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>
</Project>
