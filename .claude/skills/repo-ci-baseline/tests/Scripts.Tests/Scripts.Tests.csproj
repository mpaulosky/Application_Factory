<Project Sdk="Microsoft.NET.Sdk">
  <!-- The xUnit v3 tests of the Factory's C# scripts (ADR 0017), run by test.sh in its scripts shard. Shielded: the three empty
       Directory.* files beside it stop any of the repo's own from reaching it, so its versions are written here. It targets net11.0, the
       runtime of the SDK global.json names, so it runs where only that SDK is installed (test.sh checks it). Warnings are errors, NuGetAudit's
       NU1901 to NU1904 among them, but not NU1900: that one says the vulnerability data couldn't be fetched (a feed outage), not that a
       package is vulnerable (mpaulosky/Application_Factory#145). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>
</Project>
