# main's history as one empty commit per merge, the Release tags on theirs, and a local bare origin;
# a merge pushed to origin after this checkout is only seen once the script fetches main.
set -euo pipefail
git init -q -b main .
commit() { git commit -q --allow-empty -m "$1"; }
commit "Initial commit"
commit "Merge 1"
git tag v1.0.0
commit "Merge 3"
commit "Merge 2"
git init -q --bare -b main "$PARITY_SCRATCH/origin.git"
git remote add origin "$PARITY_SCRATCH/origin.git"
git push -q origin main --tags
git clone -q "$PARITY_SCRATCH/origin.git" "$PARITY_SCRATCH/later"
git -C "$PARITY_SCRATCH/later" commit -q --allow-empty -m "Merge 4"
git -C "$PARITY_SCRATCH/later" push -q origin main
