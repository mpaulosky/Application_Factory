rest.POST.repos_o_app_rulesets gh api -X POST repos/o/app/rulesets -H "Accept: application/vnd.github+json" --input - <<< "{\"bypass_actors\":[],\"conditions\":{\"ref_name\":{\"exclude\":[],\"include\":[\"~DEFAULT_BRANCH\"]}},\"enforcement\":\"active\",\"name\":\"main-rules\",\"rules\":[{\"type\":\"deletion\"},{\"parameters\":{\"allowed_merge_methods\":[\"squash\"],\"required_review_thread_resolution\":false},\"type\":\"pull_request\"},{\"parameters\":{\"required_status_checks\":[{\"context\":\"Build Solution\",\"integration_id\":15368},{\"context\":\"PR title\",\"integration_id\":15368},{\"context\":\"markdownlint\",\"integration_id\":15368}],\"strict_required_status_checks_policy\":true},\"type\":\"required_status_checks\"}],\"target\":\"branch\"}"
rest.POST.repos_o_app_labels gh api -X POST repos/o/app/labels -H "Accept: application/vnd.github+json" --input - <<< "{\"color\":\"0075CA\",\"description\":\"Changes only docs; CI skips the build and tests\",\"name\":\"docs-only\"}"
