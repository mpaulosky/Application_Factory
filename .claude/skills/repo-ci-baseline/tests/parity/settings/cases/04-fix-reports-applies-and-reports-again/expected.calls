rest.PUT.repos_o_app_actions_permissions_workflow gh api -X PUT repos/o/app/actions/permissions/workflow -H "Accept: application/vnd.github+json" --input - <<< "{\"can_approve_pull_request_reviews\":true,\"default_workflow_permissions\":\"read\"}"
