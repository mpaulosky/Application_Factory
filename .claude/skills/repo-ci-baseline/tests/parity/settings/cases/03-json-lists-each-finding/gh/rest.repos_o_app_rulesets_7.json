{
  "id": 7,
  "name": "main-rules",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main",
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "pull_request"
    }
  ],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": [
          "squash",
          "rebase"
        ],
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "PR title"
          },
          {
            "context": "Build Solution",
            "integration_id": 15368
          },
          {
            "context": "All Tests Passed",
            "integration_id": 15368
          },
          {
            "context": "Gone Check",
            "integration_id": 15368
          }
        ]
      }
    },
    {
      "type": "code_quality",
      "parameters": {
        "severity": "errors"
      }
    }
  ],
  "source_type": "Repository",
  "source": "o/app",
  "node_id": "RRS_1"
}
