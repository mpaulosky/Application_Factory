<?xml version="1.0" encoding="utf-8"?>
<!-- The bench restores its one package, YamlDotNet, from nuget.org alone (ADR 0017, Update for mpaulosky/Application_Factory#161), as tests/Scripts.Tests does:
     <clear /> drops every source and mapping a NuGet.config above this folder or the user's own adds, and packages.lock.json beside it pins the package's hash,
     which claude-review-bench.cs restores against in locked mode. -->
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
	</packageSources>
	<packageSourceMapping>
		<clear />
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
	<auditSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	</auditSources>
</configuration>
