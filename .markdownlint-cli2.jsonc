// markdownlint-cli2 config for the Factory's own Markdown (CLAUDE.md, README.md, GLOSSARY.md, docs/), used by the pre-commit
// hook. The repo-ci-baseline skill lints its own files under the Template's config in test.sh; this one keeps the same rules
// for everything else.
{
  "config": {
    "default": true,
    // Lines up to 200 characters; tables and code blocks can't wrap.
    "MD013": { "line_length": 200, "tables": false, "code_blocks": false },
    "MD010": { "code_blocks": false },
    "MD025": { "front_matter_title": "" }
  },
  // The Template's Seed .sandcastle/ Markdown uses the Sandcastle config (inline tags, one heading per
  // section); test.sh lints it under that config, as Apply writes it.
  // The shared skills and the starting points (ADR 0007) keep the text they had in dotfiles, long lines included.
  "ignores": [
    "**/node_modules/**",
    "**/.pytest_cache/**",
    ".claude/skills/repo-ci-baseline/template/seed/.sandcastle/**",
    ".claude/skills/{build-repair,dotnet-*,remove-squad,review-changes}/**",
    "starting-points/**",
    // A form, not a document (ADR 0009): its sections are ## headings with no title, and a disable comment
    // would land in every PR description and squash commit. The Template's config ignores it too.
    ".github/pull_request_template.md"
  ]
}
